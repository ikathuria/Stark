# ─────────────────────────── Required ────────────────────────────────────────

ANTHROPIC_API_KEY=        # console.anthropic.com — used for Claude Haiku (voice loop)
                          #   and Claude Sonnet (planning mode + screen reader)

# ─────────────────────────── TTS (primary) ───────────────────────────────────

ELEVENLABS_API_KEY=       # elevenlabs.io — free tier: 10,000 chars/month
                          #   if absent, Stark falls back to Kokoro → pyttsx3

ELEVENLABS_VOICE_ID=      # any voice ID from your ElevenLabs account
                          #   default: Adam (pNInz6obpgDQGcFmaJgB)

# ─────────────────────────── Identity ────────────────────────────────────────

STARK_USER_NAME=          # your name — Stark will address you by it
                          #   e.g. STARK_USER_NAME=Alex

# ─────────────────────────── Projects ────────────────────────────────────────

STARK_PROJECTS_DIR=       # root directory for new projects created by planning mode
                          #   and where projects.json lives
                          #   default: ~/projects
                          #   e.g. STARK_PROJECTS_DIR=C:\Users\you\projects

# ─────────────────────────── Hotkey ──────────────────────────────────────────

STARK_HOTKEY=ctrl+shift+s # global hotkey to trigger voice input from any window
                          #   requires admin/elevated privileges on Windows
                          #   set to empty string to disable: STARK_HOTKEY=
                          #   examples: alt+s   ctrl+alt+space   f9
