# Required
ANTHROPIC_API_KEY=        # get from console.anthropic.com

# TTS — primary (ElevenLabs free tier: 10k chars/mo)
ELEVENLABS_API_KEY=       # get from elevenlabs.io
ELEVENLABS_VOICE_ID=      # default: Adam (pNInz6obpgDQGcFmaJgB) — any ElevenLabs voice ID

# Optional
STARK_USER_NAME=          # your name — Stark will address you by it
STARK_PROJECTS_DIR=       # path to your local projects folder e.g. C:\Users\you\projects
STARK_HOTKEY=ctrl+shift+s # hotkey to trigger voice input from anywhere (default: ctrl+shift+s)
